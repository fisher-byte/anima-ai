# Anima Environment Configuration
# Copy this file to .env and fill in your values

# Server port (default: 3000)
PORT=3000

# Data directory for SQLite persistence
# In Docker: mount a volume here
DATA_DIR=./data

# Authentication — open product mode (no login required)
# Users get auto-generated UUID tokens stored in localStorage.
# No ACCESS_TOKEN whitelist needed; any token is accepted as a user ID.
#
# 本地开发若不想登录：设 AUTH_DISABLED=true，或不要配置 ACCESS_TOKEN / ACCESS_TOKENS。
# 若从生产复制了带 ACCESS_TOKEN 的 .env，行为会与线上一致（需登录），属正常现象。
AUTH_DISABLED=false

# Shared API Key — used for all users who haven't set their own key
# Users with their own key (set in Settings) use that instead
SHARED_API_KEY=sk-your-shared-key-here

# Global daily cost limit for server-paid keys (default: ¥5, shared across ALL users)
# Users with their own key are not subject to this limit.
# Optional override: AI_PRICE_PER_1K_TOKENS (default ¥0.05, conservative blended estimate)
DAILY_LIMIT_YUAN=5

# Built-in embedding API key (Aliyun DashScope — for vector search & memory indexing)
# Required for semantic memory features. Uses text-embedding-v4 model.
BUILTIN_EMBED_API_KEY=sk-your-dashscope-key-here

# Vite API URL override (used in Electron mode only)
# VITE_API_URL=https://api.moonshot.cn/v1
